# To separate your traces from other application
LANGSMITH_PROJECT=new-agent

# Add API keys for connecting to LLM providers, data sources, and other integrations here

# ── LLM 接入（百炼 DashScope 兼容 OpenAI 端点）──
# 所有文本/代码模型均走 OPENAI_BASE_URL 的兼容端点，免费额度可用模型清单（均可直接填到下方 *_MODEL 变量）：
#   qwen3.7-flash-2026-07-15, qwen3.7-plus, qwen3.5-ocr, qwen3.7-flash,
#   qwen3.7-max-2026-05-17, qwen3.7-max-2026-06-08, qwen3.7-max-preview,
#   deepseek-v4-flash-0731, qwen3.7-max, glm-5.2
# 注意：带快照日期的模型在免费额度下可能返回 403 FreeTierOnly，优先用裸名或已验证可用的快照。
# 默认走 DashScope（多媒体/通义系模型用），SWE 代码智能体如需切到 DeepSeek 见下方示例。
OPENAI_API_KEY=your-dashscope-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── SWE 代码智能体：专用 DeepSeek 接入（不影响多媒体的 DashScope 接入）──
# 仅 src/agent/swe/graph.py 与 evolution.py 读取以下 SWE_ 前缀变量；
# 未设置时自动回退到上面的全局 OPENAI_* / MODEL_NAME（百炼 DashScope）。
SWE_OPENAI_API_KEY=your-deepseek-api-key
SWE_OPENAI_BASE_URL=https://api.deepseek.com
SWE_MODEL_NAME=deepseek-v4-flash
SWE_FALLBACK_MODELS=deepseek-v4-pro,deepseek-v4-flash

# 多媒体文本生成首选模型（覆盖 text_llm.py fallback 链首选）；留空则自动按内置链降级。
DASHSCOPE_TEXT_MODEL=qwen3.7-max-2026-06-08

# 图片生成主模型（覆盖 image_gen.py 链首选）。仅可用 qwen-image 系列：
#   qwen-image-3.0, qwen-image-3.0-pro, qwen-image-2.0-pro-2026-06-22
DASHSCOPE_IMAGE_MODEL=qwen-image-3.0-pro

# 视频生成主模型（覆盖 video_gen.py 链首选）。仅可用：
#   文生视频:  wan2.7-t2v-2026-06-12, wan3.0-video, happyhorse-1.1-t2v
#   图生视频:  happyhorse-1.1-i2v, wan2.7-r2v-2026-06-12
#   首尾帧双控: wan2.7-r2v-2026-06-12, happyhorse-1.1-r2v
DASHSCOPE_VIDEO_MODEL=

# 视觉评估（审片）模型：多模态理解，仅用清单内 qwen-image-3.0-pro。
DASHSCOPE_VISION_MODEL=qwen-image-3.0-pro

# ─────────────────────────────────────────────────────────────────────────────
# ── Google AI Studio（Gemini）接入：用于生成图片与视频 ──
# 申请地址：https://aistudio.google.com/apikey  （复制 API Key 填入下方）
# 用途：当 DashScope 免费额度耗尽时，可用 Gemini 的 Imagen（生图）/ Veo（生视频）
#       作为替代后端。填入有效 key 后，将 MULTIMODIA_BACKEND 切到 google 即可启用。
#
# ⚠️ 填写说明（把这行占位符替换成你从 Google AI Studio 拿到的真实 key）：
GEMINI_API_KEY=__FILL_ME_GOOGLE_AI_STUDIO_KEY__

# 多媒体后端选择：dashscope（默认，阿里百炼） | google（Gemini Imagen/Veo）
# 填 google 后，image_gen 与 video_gen 将优先走 Gemini 端点。
MULTIMODIA_BACKEND=dashscope

# Gemini 图像生成模型（Imagen 系列）。可选值示例：
#   im-3.0-generate-002, imagen-3.0-generate-002, gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=im-3.0-generate-002

# Gemini 视频生成模型（Veo 系列）。可选值示例：
#   veo-3.0-generate-preview, veo-2.0-generate-001
GEMINI_VIDEO_MODEL=veo-3.0-generate-preview

# Gemini 基础 URL（Google Generative Language API 官方端点，一般无需改动）
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta


# ─────────────────────────────────────────────────────────────────────────────
# ── Pollinations.AI 免费后端（无需 API Key，零成本兜底）──
# 官网：https://pollinations.ai  （端点无需鉴权，直接 REST 调用）
# 适用场景：当 DashScope / Google 免费额度均耗尽时，启用此后端继续出片。
# 启用方式：将 MULTIMODIA_BACKEND 改为 pollinations（见上方），无需任何 key。
# 能力：文生图 + 文生视频，免费社区算力；不支持参考图/首帧图/负面提示词，
#       画质弱于商用模型但零成本，作为兜底后端保全流程不中断。
# ─────────────────────────────────────────────────────────────────────────────
# 生图端点（一般无需改动）
POLLINATIONS_IMAGE_ENDPOINT=https://image.pollinations.ai/prompt
# 生视频端点（一般无需改动）
POLLINATIONS_VIDEO_ENDPOINT=https://video.pollinations.ai/prompt
# 生图模型：留空=自动（autodetect）。可选如 flux、turbo
POLLINATIONS_IMAGE_MODEL=
# 生视频模型：留空=自动。可选如 veo-3.1-generate-preview（若 Pollinations 支持）
POLLINATIONS_VIDEO_MODEL=
# 单次请求超时（秒），视频生成较慢可放宽
POLLINATIONS_TIMEOUT=120
# 默认视频时长（秒）
POLLINATIONS_VIDEO_DURATION=5


# ─────────────────────────────────────────────────────────────────────────────
# ── 即梦 AI Free（jimeng-api）免费后端：白嫖即梦网页版每日免费积分 ──
# 项目地址：https://github.com/hedashuaiii/jimeng-api （fork 自 DylanWu92/jimeng-free-api-all）
# 简介：把即梦官网每日赠送的免费积分（默认 ~66 积分/天）暴露为 OpenAI 兼容本地 API，
#       支持生图 / 图生图(参考图) / 文生视频 / 图生视频 / Seedance 2.0 多参考图。
# 部署：本地起 jimeng-api 服务（如 docker run -p 8080:8080 ...），用网页版 sessionid 鉴权。
# 启用方式：将 MULTIMODIA_BACKEND 改为 jimeng（直接走即梦）；或保持 dashscope，
#           仅填下方 JIMENG_SESSION_ID，作为百炼额度耗尽时的自动兜底后端。
# ⚠️ 注意：逆向 API 仅个人自用，随官网改版可能失效；免费层无角色一致性硬锁定，
#        需靠多参考图/尾帧衔接尽量维持；请勿将 sessionid 写入公开仓库。
# ─────────────────────────────────────────────────────────────────────────────
# 即梦本地服务地址（jimeng-api docker 默认 -p 8000:8000，监听 /v1）。改 backend 为 jimeng 时必填。
JIMENG_BASE_URL=http://localhost:8000/v1
# 即梦网页版 sessionid（多个用逗号分隔轮换，降低单号封禁风险；至少一个才启用兜底）。
# 获取：浏览器登录即梦官网后，从 Cookie / 请求头中取 sessionid。
JIMENG_SESSION_ID=

# 多媒体后端选择：dashscope（默认） | google（Gemini） | pollinations（免费兜底） | jimeng（即梦免费）
MULTIMODIA_BACKEND=dashscope


# ─────────────────────────────────────────────────────────────────────────────
# ── Agnes AI 免费视频后端（默认视频生成渠道，完全免费、无需信用卡）──
# 官网/注册：https://platform.agnes-ai.com  （拿到免费 API Key 填入下方）
# 文档：https://github.com/ChenOneTo/agnes-video-gen
# 能力（实测确认）：文生视频 / 图生视频 / 关键帧动画(keyframes 多图模式)。
#   关键帧模式 extra_body.image 支持多张参考图：可把「首尾帧关键帧 + 角色转面图 +
#   道具/环境参考图」一起注入，实现素材参考图对视频生成的完整融入（比即梦更完整）。
# 启用方式：VIDEO_PROVIDER=agnes（默认值即如此）。该后端与 MULTIMODIA_BACKEND(生图)
#   解耦——只要配了 AGNES_API_KEY，视频默认走 Agnes 免费链，生图仍可走即梦/DashScope。
# ⚠️ 免费档限制（实测）：视频生成每分钟 1 次请求（429 限流，脚本已内置退避重试）；
#   num_frames 须满足 8n+1 且 <=441；尺寸会被服务端自动对齐。
#   限流/网络偶发失败时自动回退到 MULTIMODIA_BACKEND 对应的视频链（jimeng/dashscope）。
# ─────────────────────────────────────────────────────────────────────────────
# 视频后端优先级：agnes（默认免费） | jimeng | dashscope
VIDEO_PROVIDER=agnes
# Agnes 免费 API Key（从 platform.agnes-ai.com 注册获取，勿提交仓库）
AGNES_API_KEY=
# 可选：自定义 endpoint / 模型（一般无需改动）
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_VIDEO_MODEL=agnes-video-v2.0
# 免费档限流退避秒数（默认 65，覆盖"每分钟 1 次"）
AGNES_RATE_LIMIT_WAIT=65

