# 前端环境变量示例（复制为 .env 后按需修改）

# LangGraph Server 地址（与 dev proxy /lg 目标保持一致）
VITE_LANGGRAPH_API_URL=http://127.0.0.1:2024
# 远程部署时需要
VITE_LANGGRAPH_API_KEY=

# 产物 URL 前缀（需与 vite.config.ts 中 /media proxy 一致）
VITE_MEDIA_BASE_URL=/media

# dev proxy 目标（可选覆盖）
VITE_LANGGRAPH_PROXY_TARGET=http://127.0.0.1:2024
VITE_MEDIA_PROXY_TARGET=http://127.0.0.1:8900
