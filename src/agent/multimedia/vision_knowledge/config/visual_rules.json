  "ambient_lighting_overrides": {
    "night": [
      "practical neon and streetlamp light → urban nightscape illumination",
      "moonlight as secondary fill → cool silver-blue ambient light from above",
      "high contrast between lit areas and deep shadow → noir atmosphere"
    ],
    "rain": [
      "volumetric rain illuminated by practical light sources → visible rain streaks",
      "wet surface reflections amplifying all light sources → doubled luminance on ground",
      "diffused ambient through rain curtain → softened contrast, hazy glow"
    ],
    "night+rain": [
      "neon light reflecting off rain-wet surfaces → doubled color saturation on ground",
      "volumetric rain streaks lit by practical neon sources → visible colored rain",
      "deep shadows with selective neon rim light → high contrast noir-rain atmosphere",
      "no natural light sources (no sun, no golden hour, no god rays) → purely artificial lighting"
    ],
    "dawn": [
      "low-angle warm light breaking through atmosphere → directional golden-orange key light",
      "cool ambient fill from remaining night sky → warm-cool split lighting",
      "long shadows and volumetric haze → dramatic early-morning atmosphere"
    ],
    "dusk": [
      "low-angle warm golden light → directional sunset key light from horizon",
      "warm sky gradient as ambient fill → orange-to-purple overhead gradient",
      "long shadows and silhouette potential → high contrast with warm highlights"
    ]
  },
